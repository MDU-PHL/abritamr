            "CADMIUM/COBALT/NICKEL",
            "CADMIUM/LEAD/ZINC",
            "CADMIUM",
            "CHROMATE",
            "COPPER/GOLD",
            "COPPER/NICKEL",
            "COPPER/SILVER",
            "COPPER",
            "FLUORIDE",
            "GOLD",
            "INTIMIN",
            "MERCURY",
            "NICKEL",
            "QUATERNARY AMMONIUM",
            "SILVER",
            "TELLURIUM",
