{
    "for_curation":{
        "complex":{
            "columns":["class","type"],
            "class": ["AMINOGLYCOSIDE", "BETA-LACTAM"],
            "type":["VIRULENCE"],
            
            "rules": {
                "VIRULENCE":[
                    {
                        "class":"Virulence",
                        "subclass": "CLASS_SUBCLASS",
                        "rule_join":"and",
                        "rule":[
                            {
                                "column":"class",
                                "value":"INTIMIN",
                                "operator":"eq"
                            }
                        ]
                    },
                    {
                        "class":"Virulence",
                        "subclass": "SUBCLASS",
                        "rule_join":"and",
                        "rule":[
                            {
                                "column":"class",
                                "value":"STX",
                                "operator":"in"
                            }
                        ]
                        
                    },
                    {
                        "class":"Virulence",
                        "subclass": "Other",
                        "rule_join":"and",
                        "rule":[
                            {
                                "column":"class",
                                "value":"",
                                "operator":"eq"
                            }
                        ]
                        
                    }
                ],
                "AMINOGLYCOSIDE": [
                    {
                        "class":"Aminoglycoside",
                        "subclass":"Aminoglycosides (Ribosomal methyltransferase)",
                        "rule_join":"and",
                        "rule":[
                                {
                                "column":"product_name",
                                "value":"rRNA",
                                "operator":"in"
                                },
                                {
                                    "column":"product_name",
                                    "value":"methyltransferase",
                                    "operator":"in"
                                }
                            ]
                    }
                ],
                "BETA-LACTAM":[
                    {
                        "class":"Beta-lactam",
                        "subclass":"Beta-lactam (Susceptible)",
                        "rule_join":"and",
                        "rule":[
                                {
                                    "column":"subtype",
                                    "value":"AMR-SUSCEPTIBLE",
                                    "operator":"eq"
                                }
                            ]
                        
                    },
                    {
                        "class":"Beta-lactam",
                        "subclass":"Carbapenemase",
                        "rule_join":"and",
                        "rule":[
                                {
                                    "column":"product_name",
                                    "value":"carbapenem-hydrolyzing",
                                    "operator":"in"
                                },
                                {
                                    "column":"product_name",
                                    "value":"OXA-51",
                                    "operator":"in"
                                }
                            ]
                    },
                    {
                        "class":"Beta-lactam",
                        "subclass":"Carbapenemase (MBL)",
                        "rule_join":"and",
                        "rule":[
                                {
                                    "column":"product_name",
                                    "value":"metallo-beta-lactamase",
                                    "operator":"in"
                                },
                                {
                                    "column":"subclass",
                                    "value":"CARBAPENEM",
                                    "operator":"eq"
                                }
                            ]
                    },
                    {
                        "class":"Beta-lactam",
                        "subclass":"Carbapenemase (OXA-51 family)",
                        "rule_join":"or",
                        "rule":[
                                {
                                    "column":"product_name",
                                    "value":"OXA-51 family",
                                    "operator":"in"
                                },
                                {
                                    "column":"allele",
                                    "value":"OXA-51",
                                    "operator":"eq"
                                }
                            ]
                    },
                    {
                        "class":"Beta-lactam",
                        "subclass":"Penicillin resistance (Staphylococcus aureus)",
                        "rule_join":"and",
                        "rule":[
                                {
                                    "column":"gene_family",
                                    "value":"blaZ",
                                    "operator":"eq"
                                }
                            ]
                    },
                    {
                        "class":"Beta-lactam",
                        "subclass":"AmpC",
                        "rule_join":"and",
                        "rule":[
                                {
                                    "column":"product_name",
                                    "value":"class C",
                                    "operator":"in"
                                }
                            ]
                    },
                    {
                        "class":"Beta-lactam",
                        "subclass":"ESBL (KPC variant)",
                        "rule_join":"and",
                        "rule":[
                                {
                                    "column":"gene_family",
                                    "value":"blaKPC",
                                    "operator":"eq"
                                },
                                {
                                    "columen":"subclass",
                                    "value":"CARBAPENEM",
                                    "operator":"not eq"
                                }
                            ]
                    },
                    {

                        "class":"Beta-lactam",
                        "subclass":"ESBL",
                        "rule_join":"and",
                        "rule":[
                                {
                                    "column":"product_name",
                                    "value":"class C",
                                    "operator":"not in"
                                },
                                {
                                    "columen":"product_name",
                                    "value":"extended[-|\\s]{1}spectrum",
                                    "operator":"r in"
                                }
                            ]
                    }
                ]
               
            }
        }
    },
    "other_antimicrobials":{
        "class" :["AMINOCOUMARIN",
            "AVILAMYCIN",
            "BACITRACIN",
            "BLEOMYCIN",
            "EDEINE",
            "FOSMIDOMYCIN",
